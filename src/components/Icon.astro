---
// One small custom SVG set (stroke icons). Always decorative: the control next to it carries visually hidden text.
interface Props { name: "phone" | "menu" | "close" | "copy"; }
const { name } = Astro.props;
const paths: Record<Props["name"], string> = {
  phone: "M6.6 3.5h2.8l1.4 4.2-2 1.4a12 12 0 0 0 6.1 6.1l1.4-2 4.2 1.4v2.8a1.6 1.6 0 0 1-1.7 1.6A16.6 16.6 0 0 1 5 5.2 1.6 1.6 0 0 1 6.6 3.5Z",
  menu: "M4 7h16M4 12h16M4 17h16",
  close: "M6 6l12 12M18 6 6 18",
  copy: "M9 9h10v10H9zM5 15V5h10",
};
---
<svg class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[name]} /></svg>
<style>
  .icon { width: 1.5rem; height: 1.5rem; flex: none; }
</style>
